/runtime/

# Результати компіляції, тестів і тимчасові кеші інструментів.
/dist/
/build/
/coverage/
/test-results/
/playwright-report/
/.cache/
/.npm/
/.tmp/
*.tsbuildinfo

# Локальна конфігурація й контакти; перевірений шаблон залишається публічним.
.env
.env.*
!.env.example
/.npmrc
/.claude/settings.local.json

